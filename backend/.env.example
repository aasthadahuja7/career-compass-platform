# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# The database connection details are configured in config/config.json
# But you can override them with environment variables if needed
DB_HOST=localhost
DB_PORT=5432
DB_NAME=career_assessment
DB_USER=postgres
DB_PASS=post123

# API Configuration
# Base URL for internal API calls (used by submit route)
API_BASE_URL=http://localhost:5000

# Environment Setup
# Copy this file to .env and update the values as needed
#
# For different environments:
# Development: NODE_ENV=development, DB_NAME=career_assessment
# Test: NODE_ENV=test, DB_NAME=career_assessment_test
# Production: NODE_ENV=production, DB_NAME=career_assessment_prod

# Database Setup Notes:
# 1. Make sure PostgreSQL is installed and running
# 2. Create the database: CREATE DATABASE career_assessment;
# 3. Update the credentials above to match your PostgreSQL setup
# 4. The Sequelize configuration in config/config.json will use these values
